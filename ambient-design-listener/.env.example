# Slack — see README for how to create the app and where each of these lives.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-5

# Channel IDs (the Cxxxxxxxx form, not the #name). Comma-separated to listen to
# more than one. NOTIFY_CHANNEL may be one of them or a separate channel.
LISTEN_CHANNELS=C0123456789
NOTIFY_CHANNEL=C0123456789

# notify is the only implemented level. draft and act are deliberately unbuilt —
# setting either one makes the process refuse to start rather than pretend.
TRUST_LEVEL=notify

# How many recent messages of channel context to send with each evaluation.
# BUFFER_SIZE=20
